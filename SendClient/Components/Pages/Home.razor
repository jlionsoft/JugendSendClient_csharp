@page "/"
@attribute [Authorize]
@inject HttpClient Http
@inject IConfiguration Config
@using System.Net.Http.Json
@using System.Text.Json.Serialization

<PageTitle>Nachricht senden</PageTitle>

<h3>Nachricht an Jugend senden</h3>

<div class="card p-3 mt-3">
    <h5>Nachricht eingeben</h5>
    <textarea class="form-control" rows="5"
              placeholder="Deine Nachricht..."
              @bind="Message"></textarea>
    <button class="btn btn-success mt-3"
            @onclick="SendMessage"
            disabled="@IsSending">
        @(IsSending ? "Sende..." : "An alle senden")
    </button>

    @if (SendSuccess)
    {
        <p class="text-success mt-2">✓ Nachricht erfolgreich gesendet.</p>
        @if (LastResult is not null)
        {
            <div class="mt-2">
                <p><strong>Nextcloud Talk:</strong> @(LastResult.NextcloudSuccess ? "Erfolgreich" : "Fehler beim Senden")</p>
                <p><strong>Matrix-Nachrichten gesendet:</strong> @LastResult.MatrixSent</p>
                <p><strong>SMS gesendet:</strong> @LastResult.SmsSent</p>
            </div>
        }
    }
    @if (SendError)
    {
        <p class="text-danger mt-2">✗ Fehler beim Senden.</p>
        <p class="text-muted">@ResultMessage</p>
    }
</div>

@code {
    private string Message = "";

    private bool IsSending = false;
    private bool SendSuccess = false;
    private bool SendError = false;
    private string ResultMessage = "";
    private SendResultDto? LastResult;

    // Konfigurationswerte aus appsettings (siehe Hinweis unten)
    private string ApiBaseUrl = "";
    private string SendEndpoint = "";
    private string AdminPassword = "";

    private class SendResultDto
    {
        [JsonPropertyName("nextcloudSuccess")]
        public bool NextcloudSuccess { get; set; }

        [JsonPropertyName("matrixSent")]
        public int MatrixSent { get; set; }

        [JsonPropertyName("smsSent")]
        public int SmsSent { get; set; }
    }

    private class SendResponseDto
    {
        [JsonPropertyName("status")]
        public string? Status { get; set; }

        [JsonPropertyName("result")]
        public SendResultDto? Result { get; set; }
    }

    protected override void OnInitialized()
    {
        ApiBaseUrl = Config["BotApi:BaseUrl"] ?? "https://bot-api.joloewen.de";
        SendEndpoint = Config["BotApi:SendEndpoint"] ?? "/api/Message/send";
        AdminPassword = Config["BotApi:AdminPassword"] ?? "Password123";
    }

    private async Task SendMessage()
    {
        IsSending = true;
        SendSuccess = false;
        SendError = false;
        try
        {
            var payload = new { message = Message };

            var uri = new Uri(new Uri(ApiBaseUrl), SendEndpoint).ToString();

            var request = new HttpRequestMessage(HttpMethod.Post, uri)
            {
                Content = JsonContent.Create(payload)
            };

            // Passwort-Header aus Konfiguration hinzufügen
            request.Headers.Add("X-Admin-Password", AdminPassword);

            var response = await Http.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                // Versucht, die strukturierte Antwort mit den Details zu lesen
                var resp = await response.Content.ReadFromJsonAsync<SendResponseDto>();
                if (resp?.Result is not null)
                {
                    LastResult = resp.Result;
                    SendSuccess = true;
                    Message = "";
                    ResultMessage = "Nachricht gesendet. Details siehe unten.";
                }
                else
                {
                    SendSuccess = true;
                    Message = "";
                    ResultMessage = "Nachricht gesendet, aber keine Detailinformationen empfangen.";
                    LastResult = null;
                }
            }
            else
            {
                SendError = true;
                ResultMessage = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            SendError = true;
            ResultMessage = ex.Message;
        }

        IsSending = false;
    }
}
